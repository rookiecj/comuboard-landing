# ─── 로컬 개발 환경 ────────────────────────────────────────────
# FE dev server (localhost:3000) 의 앱 URL
# Landing의 CTA 버튼(무료로 시작하기, 로그인 등)이 가리키는 FE 앱의 base URL
# Dev: https://app.changju.dev/app/comuboard
# Prod: (빈값 — 같은 도메인 루트)
VITE_APP_URL=http://localhost:3002/app/comuboard

# API base URL (Landing 자체의 API 호출용 — 서비스 통계 등)
# Dev: https://app.changju.dev
# Prod: (빈값 — 같은 도메인)
VITE_API_URL=http://localhost:3002/app/comuboard

# ─── Sentry (STORY-189-03) ─────────────────────────────────────
# Sentry DSN — comuboard-landing 프로젝트의 DSN.
# 비어 있으면 SDK가 no-op으로 동작하므로 로컬 개발 시 비워둬도 됩니다.
VITE_SENTRY_DSN=

# Sentry environment 태그 (e.g. development / dev / prod). 미설정 시 Vite MODE 사용.
VITE_SENTRY_ENV=development

# Sentry release 태그 — CI에서 VERSION 파일 값 또는 git SHA 주입 권장.
VITE_SENTRY_RELEASE=

# 일반 이벤트 샘플링 비율 (0.0–1.0, 기본 1.0 = 모두 전송).
VITE_SENTRY_SAMPLE_RATE=1.0

# Performance/Web Vitals 트레이스 샘플링 비율 (0.0–1.0, 기본 0.1 = 10%).
# tracesSampleRate > 0 일 때 browserTracingIntegration이 LCP/FID/CLS/INP를 자동 수집.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Sentry CLI source map upload (STORY-186-01) ───────────────
# `npm run sourcemaps:upload` 실행 시 필요한 환경변수.
# 모두 비어 있으면 스크립트가 no-op으로 종료되어 CI 실패하지 않습니다.
# Sentry → Settings → Auth Tokens → "project:write" + "release:write" scope.
SENTRY_AUTH_TOKEN=
# Sentry organization slug (대시보드 URL의 /organizations/{slug}/ 부분).
SENTRY_ORG=
# Sentry project slug — Landing 빌드용 (e.g. comuboard-landing).
SENTRY_PROJECT=
# Release 태그 (미설정 시 VITE_SENTRY_RELEASE 사용).
SENTRY_RELEASE=
