# FE dev server (localhost:3000) 의 앱 URL
# Landing의 CTA 버튼(무료로 시작하기, 로그인 등)이 가리키는 FE 앱의 base URL
# Dev: https://app.changju.dev/app/comuboard
# Prod: (빈값 — 같은 도메인 루트)
VITE_APP_URL=http://localhost:3002/app/comuboard

# API base URL (Landing 자체의 API 호출용 — 서비스 통계 등)
# Dev: https://app.changju.dev
# Prod: (빈값 — 같은 도메인)
VITE_API_URL=http://localhost:3002/app/comuboard
